{
  // Upgrades to a separate output path using the local test server. The
  // served archive holds a placeholder binary, so the upgrade fails at
  // executable validation, after the download and extraction.
  "if": "notWindowsArm",
  "tempDir": true,
  "steps": [
    {
      "args": "eval Deno.copyFileSync(Deno.execPath(),'./deno_copy');",
      "exitCode": 0,
      "output": ""
    },
    {
      "commandName": "./deno_copy",
      "args": "upgrade --force --version 99.99.99 --output ./deno_copy2",
      "envs": { "DENO_TESTING_UPGRADE": "1" },
      "output": "upgrade.out",
      "exitCode": 1
    }
  ]
}
