{
  // Extracts the upgrade archive into a temp dir whose path contains a space,
  // using the local test server. The served archive holds a placeholder
  // binary, so the upgrade fails at executable validation, after extraction.
  "if": "notWindowsArm",
  "tempDir": true,
  "steps": [
    {
      "args": "eval Deno.copyFileSync(Deno.execPath(),'./deno_copy');",
      "exitCode": 0,
      "output": ""
    },
    {
      "args": ["eval", "Deno.mkdirSync('space in cwd')"],
      "exitCode": 0,
      "output": "[WILDCARD]"
    },
    {
      "commandName": "./deno_copy",
      "args": "upgrade --force --version 99.99.99",
      "envs": { "TMP": "./space in cwd", "DENO_TESTING_UPGRADE": "1" },
      "output": "upgrade.out",
      "exitCode": 1
    }
  ]
}
