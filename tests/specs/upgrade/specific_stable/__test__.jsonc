{
  // Verifies that `upgrade` downloads from Mokou's GitHub releases rather than
  // upstream Deno. v1.43.2 is an upstream Deno version that Mokou will never
  // publish, so the download must come back as not found.
  "if": "notWindowsArm",
  "tempDir": true,
  "steps": [
    {
      "args": "eval Deno.copyFileSync(Deno.execPath(),'./deno_copy');",
      "exitCode": 0,
      "output": ""
    },
    {
      "commandName": "./deno_copy",
      "args": "upgrade --force --version 1.43.2",
      "output": "upgrade.out",
      "exitCode": 1,
      "flaky": true
    }
  ]
}
