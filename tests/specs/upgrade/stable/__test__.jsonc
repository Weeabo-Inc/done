{
  // Looks up the latest stable version and downloads it from the local test
  // server. The served archive holds a placeholder binary, so the upgrade
  // fails at executable validation, after the download and extraction.
  "if": "notWindowsArm",
  "tempDir": true,
  "envs": {
    "DENO_DONT_USE_INTERNAL_BASE_UPGRADE_URL": "http://localhost:4545",
    "DENO_TESTING_UPGRADE": "1"
  },
  "args": "upgrade --force --dry-run",
  "output": "upgrade.out",
  "exitCode": 1
}
